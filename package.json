{
  "name": "thug2-thps4-level-converter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "THUG2 THPS4 Level Converter: Tony Hawk's Pro Skater 4 (PC) levels converted to Tony Hawk's Underground 2's formats.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CanuckAussieKev/thug2-thps4-level-converter.git"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./*.ts": {
      "types": "./*.ts",
      "default": "./*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "node --test \"**/*.test.ts\""
  },
  "dependencies": {
    "thug2-level-converter-core": "github:CanuckAussieKev/thug2-level-converter-core#ef964ed703c1875e744a6750a8b9ad9e5c5c4e13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
